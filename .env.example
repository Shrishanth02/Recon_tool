# RECON-X environment configuration — copy to `.env` and adjust.
#
#   cp .env.example .env
#
# Values below are safe defaults for local docker-compose. Change JWT_SECRET
# (and the Postgres credentials) before deploying anywhere real.

# --- Persistence ------------------------------------------------------------ #
# Postgres connection used by the backend (psycopg v3 driver).
# Host "postgres" is the compose service name; use localhost if running the API
# outside the container.
DATABASE_URL=postgresql+psycopg://reconx:reconx@postgres:5432/reconx

# Postgres init credentials (consumed by the postgres service). Keep these in
# sync with DATABASE_URL above.
POSTGRES_DB=reconx
POSTGRES_USER=reconx
POSTGRES_PASSWORD=reconx

# Redis connection (queue/broker backend; used by arq in Phase 2).
REDIS_URL=redis://redis:6379/0

# --- Auth / JWT ------------------------------------------------------------- #
# CHANGE THIS. Generate a strong value, e.g. `openssl rand -hex 32`.
JWT_SECRET=dev-insecure-change-me
JWT_ALG=HS256
ACCESS_TTL_MIN=30
REFRESH_TTL_DAYS=14

# --- Optional bootstrap seed ------------------------------------------------ #
# If set, an initial admin user/org is created on first startup.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ORG_NAME=RECON-X

# --- General ---------------------------------------------------------------- #
# DEBUG=true relaxes checks for local dev; set false in real deployments.
DEBUG=false

# --- Scanner engine (legacy RECONX_* aliases) ------------------------------- #
# Path to the ffuf/dirbuster wordlist (defaults to the bundled SecLists file).
# RECONX_WORDLIST=
# Comma-separated CORS origins allowed to call the API.
RECONX_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Per-scan timeout in seconds.
RECONX_SCAN_TIMEOUT=1800
# Max simultaneous scans.
RECONX_MAX_CONCURRENT=4
# Optional API key; empty means the API is open (no key required).
RECONX_API_KEY=

# --- Frontend --------------------------------------------------------------- #
# Browser-facing backend base URL. Baked into the SPA at build time by Vite,
# so it must be reachable from the user's browser (the host), not the
# compose-internal hostname.
VITE_API_BASE=http://localhost:8002

# --- Phase 2: execution core & safety gates --------------------------------- #
# These compose-level names are mapped to the app's RECONX_* settings in
# docker-compose.yml. All default to the verified Phase 0/1 behaviour, so the
# stack keeps running inline (no queue, no docker sandbox) until you opt in.
#
# Where scans execute:
#   inline - run in the API process (default; no worker needed)
#   queue  - enqueue to Redis; the "worker" service runs them out of process
# NOTE: the dedicated worker service always runs as the queue backend. Set this
# to "queue" so the API enqueues jobs for it instead of running them inline.
EXECUTION_BACKEND=inline

# Scanner sandbox:
#   none   - run scanner tools directly in the worker (default)
#   docker - run each scanner tool in an isolated docker container
SANDBOX_MODE=none

# Require an asset to be ownership-verified before it can be scanned.
REQUIRE_VERIFIED_ASSET=false

# Block scans against private / loopback / link-local / cloud-metadata targets.
# Keep this true unless you are intentionally scanning internal ranges.
BLOCK_PRIVATE_TARGETS=true
