# Python bytecode / caches
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Local databases, backups & dumps (Postgres is used in the container) — never
# bake any local data into the image.
*.db
*.sqlite
*.sqlite3
*.bak
*.bak-*
*.backup
*.sql
reconx.db

# Generated reports (regenerated at runtime; may contain findings / client PII)
*.html
_purple_report.html

# Local env / secrets — never bake into the image
.env
.env.*
!.env.example

# Dev-only requirements
requirements-dev.txt

# Docker / VCS / editor cruft
Dockerfile
.dockerignore
.git/
.gitignore
.idea/
.vscode/
*.log
