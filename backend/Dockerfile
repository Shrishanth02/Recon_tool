# RECON-X API image
#
# The default execution backend is "inline", so the auto-pentest pipeline runs
# IN THIS image. It therefore ships the full set of REQUIRED scanner binaries:
#   nmap (apt) + subfinder / httpx / nuclei / ffuf (pinned, checksum-verified).
# Optional tools (sqlmap / dalfox / katana / gau / arjun) are NOT installed here;
# their stages degrade gracefully and the /preflight check reports what's present.

FROM python:3.11-slim

# Don't buffer stdout/stderr (so logs stream straight to docker), don't write
# .pyc files, and keep pip from caching wheels into the image layer.
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Pinned scanner-toolchain versions (kept in sync with Dockerfile.worker).
ARG SUBFINDER_VERSION=2.6.6
ARG HTTPX_VERSION=1.6.9
ARG NUCLEI_VERSION=3.3.7
ARG FFUF_VERSION=2.1.0
ARG TARGETARCH=amd64

# System dependencies:
#   nmap             - port/service scanner (REQUIRED, stage 4)
#   whois            - WHOIS lookup used by python-whois (stage 1)
#   ca-certificates  - TLS roots for outbound HTTPS (builtwith / scans / downloads)
#   curl / unzip     - fetch + unpack the pinned release binaries (build-time)
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        nmap \
        whois \
        ca-certificates \
        curl \
        unzip \
    && rm -rf /var/lib/apt/lists/* \
    && nmap --version

# Install the REQUIRED release-binary scanners with pinned versions + SHA-256
# checksum verification (same script the worker uses, so they never drift). The
# build FAILS if any required tool cannot be installed/verified.
COPY install-scanners.sh /usr/local/bin/install-scanners.sh
RUN SUBFINDER_VERSION="${SUBFINDER_VERSION}" HTTPX_VERSION="${HTTPX_VERSION}" \
    NUCLEI_VERSION="${NUCLEI_VERSION}" FFUF_VERSION="${FFUF_VERSION}" \
    TARGETARCH="${TARGETARCH}" sh /usr/local/bin/install-scanners.sh

WORKDIR /app

# Install Python dependencies first so this layer is cached across code changes.
COPY requirements.txt ./
# Reproducible install from the fully-pinned, hashed lock (requirements.txt is
# generated by pip-compile from requirements.in). --require-hashes refuses any
# package whose artifact hash doesn't match the lock.
RUN pip install --no-cache-dir --require-hashes -r requirements.txt

# Copy ONLY the application runtime as an explicit allow-list — never `COPY . .`,
# so no local artifact (dev DBs, *.bak backups, generated reports, .env) can be
# baked into the image even if .dockerignore is later edited. The entrypoint
# applies migrations, so alembic.ini + migrations/ are required here.
COPY app ./app
COPY migrations ./migrations
COPY alembic.ini entrypoint.sh ./

# Normalize line endings and make the entrypoint executable (works whether the
# repo was checked out on Windows or Unix).
RUN sed -i 's/\r$//' entrypoint.sh && chmod +x entrypoint.sh

# --- Least privilege: run as a dedicated non-root user --------------------- #
# The scanner tools write config/cache under $HOME (nuclei templates, subfinder
# config) and scratch under /tmp (nmap XML), so the user gets a writable HOME;
# the app tree is owned read-only by the user. NO Linux capability is required
# for the default scan profiles: unprivileged nmap runs a TCP connect + version
# scan (only aggressive '-O' OS-detection degrades, which we accept rather than
# grant CAP_NET_RAW); subfinder/httpx/nuclei/ffuf are plain TCP/DNS clients;
# gunicorn binds :8002 (>1024, no NET_BIND_SERVICE needed).
RUN groupadd -r reconx \
    && useradd -r -g reconx -u 10001 -m -d /home/reconx reconx \
    && chown -R reconx:reconx /app /home/reconx
ENV HOME=/home/reconx \
    XDG_CONFIG_HOME=/home/reconx/.config \
    XDG_CACHE_HOME=/home/reconx/.cache
USER reconx

EXPOSE 8002

# The entrypoint runs `alembic upgrade head` (on a real DB) then launches
# gunicorn + uvicorn workers. Bind 0.0.0.0:8002 to match the rest of the stack.
CMD ["./entrypoint.sh"]
